{
  "name": "enterprise-agent-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal enterprise agent workflow with tools, permissions, RAG retrieval, reranking, CLI, HTTP API, and evals.",
  "scripts": {
    "chat": "tsc -p tsconfig.build.json && node dist/cli.js",
    "server": "tsc -p tsconfig.build.json && node dist/server/http.js",
    "eval": "tsc -p tsconfig.build.json && node dist/eval/run-eval.js",
    "eval:dealer": "tsc -p tsconfig.build.json && node dist/eval/dealer-smoke.js",
    "smoke": "tsc -p tsconfig.build.json && node dist/eval/smoke.js",
    "eval:router": "tsc -p tsconfig.build.json && node dist/eval/router-poc.js",
    "router:governance": "tsc -p tsconfig.build.json && node dist/eval/router-governance.js",
    "router:commands": "tsc -p tsconfig.build.json && node dist/eval/router-commands.js",
    "tool:timeout": "tsc -p tsconfig.build.json && node dist/eval/tool-timeout.js",
    "tool:abort": "tsc -p tsconfig.build.json && node dist/eval/tool-abort.js",
    "tool:retry": "tsc -p tsconfig.build.json && node dist/eval/tool-retry.js",
    "emit:resilience": "tsc -p tsconfig.build.json && node dist/eval/emit-resilience.js",
    "prompt:authority-alert": "tsc -p tsconfig.build.json && node dist/eval/prompt-authority-alert.js",
    "prompt:alert-dedup": "tsc -p tsconfig.build.json && node dist/eval/prompt-alert-dedup.js",
    "context:ingest-hook": "tsc -p tsconfig.build.json && node dist/eval/context-ingest-hook.js",
    "ingest:failure": "tsc -p tsconfig.build.json && node dist/eval/ingest-failure.js",
    "handlers:auth": "tsc -p tsconfig.build.json && node dist/eval/handlers-auth.js",
    "commands:api": "tsc -p tsconfig.build.json && node dist/eval/commands-api.js",
    "item:watchdog": "tsc -p tsconfig.build.json && node dist/eval/item-watchdog.js",
    "metrics:smoke": "tsc -p tsconfig.build.json && node dist/eval/metrics-collector.js",
    "arch:smoke": "tsc -p tsconfig.build.json && node dist/eval/architecture-smoke.js",
    "session:smoke": "tsc -p tsconfig.build.json && node dist/eval/session-recovery.js",
    "workspace:isolation": "tsc -p tsconfig.build.json && node dist/eval/workspace-isolation.js",
    "evolution:smoke": "tsc -p tsconfig.build.json && node dist/eval/evolution-runtime.js",
    "evolution:governance": "tsc -p tsconfig.build.json && node dist/eval/evolution-governance.js",
    "memory:evolution-stack": "tsc -p tsconfig.build.json && node dist/eval/memory-evolution-stack.js",
    "hook:evolution-loop": "tsc -p tsconfig.build.json && node dist/eval/hook-runtime-evolution-loop.js",
    "business:runtime": "tsc -p tsconfig.build.json && node dist/eval/business-agent-runtime.js",
    "trace:maturity": "tsc -p tsconfig.build.json && node dist/eval/trace-maturity.js",
    "a2ui:adapter": "tsc -p tsconfig.build.json && node dist/eval/a2ui-adapter.js",
    "skill:curator": "tsc -p tsconfig.build.json && node dist/eval/skill-curator-maintenance.js",
    "task:smoke": "tsc -p tsconfig.build.json && node dist/eval/task-store.js",
    "config:check": "tsc -p tsconfig.build.json && node dist/eval/config-check.js",
    "typecheck": "tsc -p tsconfig.json",
    "build:ts": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
