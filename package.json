    "scheduler:self-driving": "tsc -p tsconfig.build.json && node dist/eval/scheduler-self-driving.js",
    "mcp:smoke": "tsc -p tsconfig.build.json && node dist/eval/mcp-client-smoke.js",
    "agent:spawn": "tsc -p tsconfig.build.json && node dist/eval/spawn-agent-smoke.js",
    "cron:smoke": "tsc -p tsconfig.build.json && node dist/eval/cron-smoke.js",
    "terminal:smoke": "tsc -p tsconfig.build.json && node dist/eval/terminal-smoke.js",
