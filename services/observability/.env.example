# ─── Langfuse 核心 ─────────────────────────────────────────────────────────
# 必须改！用 openssl rand -hex 32 生成
LANGFUSE_NEXTAUTH_SECRET=changeme-please-use-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=changeme-please-use-openssl-rand-hex-32
LANGFUSE_SALT=changeme-please-use-openssl-rand-hex-32

# Web URL，外网访问时改成实际 host
LANGFUSE_NEXTAUTH_URL=http://localhost:3001

# 是否开放注册（生产环境建议第一个 admin 注册完后改 false）
LANGFUSE_AUTH_DISABLE_SIGNUP=false

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_VERSION=17
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=changeme
POSTGRES_DB=langfuse

# ─── ClickHouse ────────────────────────────────────────────────────────────
# v3 强制依赖。pin 到 LTS，避免大版本被动升级
CLICKHOUSE_VERSION=24.8
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=default

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_VERSION=7
REDIS_AUTH=changeme

# ─── MinIO（S3 兼容） ──────────────────────────────────────────────────────
# Langfuse v3 用 3 个独立 bucket
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=changeme-minio-pass
LANGFUSE_S3_REGION=auto

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-export

# ─── Telemetry ────────────────────────────────────────────────────────────
# 关闭 Langfuse 自带匿名 telemetry（默认开）
TELEMETRY_ENABLED=false

# ─── Dashboards (Phase 1 后期) ────────────────────────────────────────────
DASHBOARD_AUTH_SECRET=changeme
DASHBOARD_LANGFUSE_API_URL=http://langfuse-web:3000
# dashboards 用单独的只读 API key（Langfuse Web UI 里再建一对）
DASHBOARD_PUBLIC_KEY=
DASHBOARD_SECRET_KEY=

# ─── Judge runner (Phase 2) ───────────────────────────────────────────────
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
JUDGE_LLM_MODEL=
