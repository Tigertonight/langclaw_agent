# Memory Service runtime configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=4310

# PostgreSQL with pgvector + pg_trgm extensions
DATABASE_URL=postgres://memory:memory@localhost:5432/memory_service
DATABASE_SCHEMA=app_memory
DATABASE_POOL_MAX=10

# Embedding provider: bge-m3-ollama | hash-fallback
EMBEDDING_PROVIDER=bge-m3-ollama
EMBEDDING_MODEL_TAG=bge-m3:v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Auth: HMAC shared secret used by SDK to sign X-Memory-Identity header
SERVICE_TOKEN_SECRET=dev-memory-secret-change-me
SERVICE_TOKEN_HEADER=X-Memory-Identity

# Logging
LOG_LEVEL=info
NODE_ENV=development
