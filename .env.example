# =============================================================================
# Enterprise Agent — 环境变量样例
# 复制为 .env 后按需填值。最小可跑：填 LLM_API_KEY 即可，其余全部走默认。
# =============================================================================

# -------- LLM（必填，OpenAI 兼容协议） --------
# 国内推荐：MiniMax / DeepSeek；海外：OpenAI / Anthropic-compatible
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7

# 可选：路由判别 / 最终回答阶段独立模型（不填则继承上面 LLM_*）
# LLM_DECISION_BASE_URL=https://api.deepseek.com/v1
# LLM_DECISION_API_KEY=
# LLM_DECISION_MODEL=deepseek-chat
# LLM_ANSWER_BASE_URL=
# LLM_ANSWER_API_KEY=
# LLM_ANSWER_MODEL=

# Prompt cache：auto（默认开，MiniMax/DeepSeek 自动 / OpenAI 走 prompt_cache_key）/ off
LLM_PROMPT_CACHE=auto
# 可选：OpenAI 兼容 provider 的 cache retention（in_memory / 24h）
LLM_PROMPT_CACHE_RETENTION=
LLM_PROMPT_CACHE_KEY_PREFIX=openclaw-agent

# -------- HTTP 服务 --------
PORT=3000
HOST=0.0.0.0
# agentic handler 详细日志，生产关闭
AGENTIC_DEBUG=

# =============================================================================
# 集成渠道：默认全部 mock，凭证就绪后再切 real
# =============================================================================

# -------- 企业微信（WeCom） --------
WECOM_MODE=mock
WECOM_BASE_URL=https://qyapi.weixin.qq.com
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
# real 模式发送消息必填
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=

# -------- 飞书（Feishu） --------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# -------- 钉钉（DingTalk Webhook） --------
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=

# -------- 腾讯文档 --------
TENCENT_DOCS_MODE=mock
TENCENT_DOCS_BASE_URL=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_REFRESH_TOKEN=
TENCENT_DOCS_DOC_IDS=
# Example: /openapi/your/content/path/{docId}
TENCENT_DOCS_CONTENT_ENDPOINT_TEMPLATE=

# =============================================================================
# 附件上传（可选）
# =============================================================================
# 不配 S3_ENDPOINT/S3_BUCKET 时附件功能自动降级（503，前端按钮变灰），主流程不影响。
# 想启用：
#   开发期：docker compose -f docker-compose.attachments.yml up -d（用以下默认值即可）
#   生产：填阿里云 OSS / AWS S3 等真实凭证
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-attachments-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO/OSS 必须 true；AWS S3 可设 false（virtual-hosted-style）
S3_FORCE_PATH_STYLE=true
# 可选：公网 base url，用于直接发可访问 URL 给前端（生产建议留空，走预签名）
S3_PUBLIC_BASE_URL=

# Chat attachments tunables
ATTACHMENTS_ENABLED=true
ATTACHMENTS_MAX_FILES_PER_REQUEST=5
ATTACHMENTS_MAX_FILE_SIZE_MB=20
# 单个附件解析后注入 prompt 的字符上限（防 context 爆炸）
ATTACHMENTS_MAX_TEXT_CHARS=20000

# =============================================================================
# Observability（Phase 9 · Langfuse 路线，未配则零成本回落 Noop）
# =============================================================================
# 总开关：false 强制关闭上报（即使 keys 配齐）
OBSERVABILITY_ENABLED=true
# 自部署 Langfuse：services/observability 下 docker compose up -d，默认 :3001
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# trace 上报前 PII 脱敏：手机号/身份证/邮箱/中文车牌
OBS_SCRUB_ENABLED=true
# 逗号分隔关闭某些规则，例 plate,id_card
OBS_SCRUB_DISABLED_RULES=

# =============================================================================
# 开发调试
# =============================================================================
# 关闭 A2UI 鉴权（npm run server 默认开，生产部署请勿设）
# A2UI_AUTH_DISABLED=1
