# Optional. If absent, the project uses a deterministic local LLM stub.
# MiniMax Mainland China official OpenAI-compatible endpoint:
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.7
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7
# auto: MiniMax/DeepSeek use provider-side automatic caching; OpenAI receives prompt_cache_key.
LLM_PROMPT_CACHE=auto
# Optional for OpenAI-compatible providers that support it: in_memory or 24h.
LLM_PROMPT_CACHE_RETENTION=
LLM_PROMPT_CACHE_KEY_PREFIX=openclaw-agent
PORT=3000

# Integrations default to mock. Switch to real only after credentials are ready.
WECOM_MODE=mock
WECOM_BASE_URL=https://qyapi.weixin.qq.com
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=

TENCENT_DOCS_MODE=mock
TENCENT_DOCS_BASE_URL=
TENCENT_DOCS_CLIENT_ID=
TENCENT_DOCS_CLIENT_SECRET=
TENCENT_DOCS_ACCESS_TOKEN=
TENCENT_DOCS_REFRESH_TOKEN=
TENCENT_DOCS_DOC_IDS=
# Example: /openapi/your/content/path/{docId}
TENCENT_DOCS_CONTENT_ENDPOINT_TEMPLATE=

# Object storage for chat attachments. S3-compatible (MinIO / Aliyun OSS / AWS S3).
# Local dev: docker compose -f docker-compose.attachments.yml up -d
# Prod (Aliyun OSS example):
#   S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
#   S3_REGION=oss-cn-hangzhou
#   S3_BUCKET=your-bucket
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agent-attachments-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO/OSS 必须 true；AWS S3 可设 false（virtual-hosted-style）
S3_FORCE_PATH_STYLE=true
# 可选：公网 base url，用于直接发可访问 URL 给前端（生产建议留空，走预签名）
S3_PUBLIC_BASE_URL=

# Chat attachments tunables
ATTACHMENTS_ENABLED=true
ATTACHMENTS_MAX_FILES_PER_REQUEST=5
ATTACHMENTS_MAX_FILE_SIZE_MB=20
# 单个附件解析后注入 prompt 的字符上限（防 context 爆炸）
ATTACHMENTS_MAX_TEXT_CHARS=20000
