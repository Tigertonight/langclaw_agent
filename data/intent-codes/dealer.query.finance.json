{
  "intent_code": "dealer.query.finance",
  "handler_type": "intent_query",
  "version": "1",
  "description": "查询经销商财务流水：折让金/应付/应收/收款/返利等款项明细，支持按门店、时间、状态、金额过滤",
  "params_schema": {
    "resource_type": {
      "type": "enum",
      "values": ["discount_wallet", "payable", "receivable", "receipt", "rebate"],
      "required": false,
      "description": "款项大类：折让金=discount_wallet，应付=payable，应收=receivable，收款=receipt，返利=rebate"
    },
    "store": { "type": "string", "required": false, "examples": ["华东旗舰店", "华南标准店"] },
    "category": { "type": "string", "required": false, "examples": ["销售返利", "整车采购", "客户首付", "月度销量返利"] },
    "direction": { "type": "string", "required": false, "examples": ["入账", "出账", "应付", "应收返利", "收款"] },
    "status": { "type": "string", "required": false, "examples": ["已入账", "未结清", "已到账", "待结算"] },
    "time_range": { "type": "string", "required": false, "examples": ["近一个月", "六月份", "本月", "Q2"] },
    "amount_min": { "type": "number", "required": false },
    "amount_max": { "type": "number", "required": false }
  },
  "examples": [
    "六月份华东旗舰店挂账中的应付金额合计",
    "返利发放但未到账的明细",
    "查一下华南标准店本月已到账的客户首付",
    "折让金最近的出账记录",
    "应收返利还有哪些待结算"
  ],
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "dealer_finance"
  },
  "required_permissions": ["finance:read"]
}
