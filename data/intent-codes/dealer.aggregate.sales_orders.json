{
  "intent_code": "dealer.aggregate.sales_orders",
  "handler_type": "intent_query",
  "version": "1",
  "description": "对销售订单做合计/平均/最高/最低/毛利率等聚合统计。当用户问『总额、合计、平均、最高、最少、占比、毛利率』时使用；问『有哪些订单、列表、明细』时改用 dealer.query.sales_orders。",
  "params_schema": {
    "metric": {
      "type": "enum",
      "values": ["total_revenue", "order_count", "avg_price", "total_profit", "gross_margin", "max_price", "min_price"],
      "required": true,
      "description": "选择要计算的指标名"
    },
    "group_by": {
      "type": "enum",
      "values": ["store_name", "series", "order_status", "payment_status", "owner_name", "order_type"],
      "required": false,
      "description": "按哪个字段分组（可选）。用户问『各门店』『按车系』时选对应字段；不分组时填 null"
    },
    "store": { "type": "string", "required": false, "examples": ["华东旗舰店"] },
    "series": { "type": "string", "required": false, "examples": ["汉", "宋L", "海豹"] },
    "owner": { "type": "string", "required": false, "description": "销售顾问姓名" },
    "time_range": { "type": "string", "required": false, "examples": ["近一个月", "本月", "Q2"] }
  },
  "metric_definitions": {
    "total_revenue": {
      "definition": "总成交额 = sum(final_price)，仅含订单状态为『待交付』『已交付』，不含『已取消』",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "sum", "field": "final_price", "as": "total_revenue" }]
    },
    "order_count": {
      "definition": "订单数 = count(*)，不含已取消",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "count", "field": "id", "as": "order_count" }]
    },
    "avg_price": {
      "definition": "平均成交价 = avg(final_price)，不含已取消",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "avg", "field": "final_price", "as": "avg_price" }]
    },
    "total_profit": {
      "definition": "总毛利 = sum(gross_profit)，不含已取消",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "sum", "field": "gross_profit", "as": "total_profit" }]
    },
    "gross_margin": {
      "definition": "毛利率 = sum(gross_profit) / sum(final_price)，已转换为百分比",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [
        { "type": "sum", "field": "gross_profit", "as": "_profit" },
        { "type": "sum", "field": "final_price", "as": "_revenue" }
      ],
      "derived": [
        { "as": "_margin", "op": "/", "left": { "ref": "_profit" }, "right": { "ref": "_revenue" } },
        { "as": "gross_margin_pct", "op": "*", "left": { "ref": "_margin" }, "right": { "const": 100 } }
      ]
    },
    "max_price": {
      "definition": "最高成交价 = max(final_price)",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "max", "field": "final_price", "as": "max_price" }]
    },
    "min_price": {
      "definition": "最低成交价 = min(final_price)",
      "filter_addon": [{ "field": "order_status", "op": "neq", "value": "已取消" }],
      "aggregations": [{ "type": "min", "field": "final_price", "as": "min_price" }]
    }
  },
  "examples": [
    "本月华东旗舰店成交总额",
    "汉EV 这一系车型整体毛利率",
    "各门店本月成交订单数",
    "本月最高单价订单",
    "按车系看平均成交价"
  ],
  "confidence_threshold": "medium",
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "dealer_sales_orders",
    "operation": "aggregate"
  },
  "required_permissions": ["order:read"]
}
