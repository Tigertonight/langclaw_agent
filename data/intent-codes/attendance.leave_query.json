{
  "intent_code": "attendance.leave_query",
  "execution_class": "controlled_execution",
  "handler_type": "intent_query",
  "version": "1",
  "description": "查询员工请假记录、请假历史、最近谁请假、团队或公司范围内的休假情况；这是查询记录，不是发起请假申请。",
  "params_schema": {
    "scope": {
      "type": "enum",
      "values": [
        "self",
        "team",
        "company"
      ],
      "required": false,
      "examples": [
        "self",
        "team",
        "company"
      ]
    },
    "applicant_name": {
      "type": "string",
      "required": false,
      "examples": [
        "林悦",
        "周辰"
      ]
    },
    "leave_type": {
      "type": "enum",
      "values": [
        "年假",
        "病假",
        "事假",
        "调休"
      ],
      "required": false
    },
    "time_range": {
      "type": "string",
      "required": false,
      "examples": [
        "最近",
        "本月",
        "近一个月",
        "近三个月"
      ]
    },
    "status": {
      "type": "string",
      "required": false,
      "examples": [
        "submitted",
        "approved"
      ]
    },
    "limit": {
      "type": "number",
      "required": false,
      "examples": [
        10,
        20
      ]
    }
  },
  "examples": [
    "最近哪些人请假了",
    "查看我的请假记录",
    "这个月团队谁请过假",
    "周辰最近请假了吗",
    "公司最近的休假记录"
  ],
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "leave_requests"
  },
  "required_permissions": [
    "leave:submit"
  ],
  "filter_mapping": {
    "scope": {
      "field": "applicant_user_id",
      "source": "message",
      "transform": "leave_scope"
    },
    "applicant_name": {
      "field": "applicant_name",
      "op": "contains"
    },
    "leave_type": [
      {
        "field": "leave_type",
        "op": "eq"
      },
      {
        "field": "leave_type",
        "op": "eq",
        "source": "message",
        "transform": "infer_leave_type"
      }
    ],
    "status": {
      "field": "status",
      "op": "eq"
    },
    "time_range": {
      "field": "start_time",
      "op": "gte",
      "source": "message",
      "transform": "month_token_or_time_range"
    }
  }
}
