{
  "version": "1",
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "intent_code": "cloud.query.products",
  "handler_type": "intent_query",
  "execution_class": "controlled_execution",
  "description": "查询云商品平台产品、Offer、SKU、规格、计费项、地域和 AI 模型目录。",
  "params_schema": {
    "product_code": {
      "type": "string",
      "required": false,
      "examples": [
        "SEEDANCE",
        "AGENT_PLAN",
        "ECS",
        "TOS",
        "CDN"
      ]
    }
  },
  "examples": [
    "Seedance 上架前有哪些商品配置",
    "Agent Plan 有哪些 SKU",
    "云商品平台有哪些产品",
    "ECS 商品化需要哪些配置项"
  ],
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "cloud_products"
  },
  "required_permissions": [
    "cloud:read"
  ],
  "filter_mapping": {
    "product_code": {
      "field": "product_code",
      "op": "eq"
    }
  }
}
