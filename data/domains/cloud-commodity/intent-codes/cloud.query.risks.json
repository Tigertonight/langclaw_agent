{
  "version": "1",
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "intent_code": "cloud.query.risks",
  "handler_type": "intent_query",
  "execution_class": "controlled_execution",
  "description": "查询云商品平台当前风险信号，适合老板视角风险总览。",
  "params_schema": {
    "severity": {
      "type": "string",
      "required": false,
      "examples": [
        "high",
        "medium"
      ]
    }
  },
  "examples": [
    "当前云商品平台有什么风险",
    "老板看现在最该关注什么",
    "有哪些高风险云商品事项"
  ],
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "cloud_risk_signals"
  },
  "required_permissions": [
    "cloud:read"
  ],
  "filter_mapping": {
    "severity": {
      "field": "severity",
      "op": "eq"
    }
  }
}
