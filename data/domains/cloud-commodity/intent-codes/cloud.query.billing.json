{
  "version": "1",
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "intent_code": "cloud.query.billing",
  "handler_type": "intent_query",
  "execution_class": "controlled_execution",
  "description": "查询云商品账单、发票、争议金额和账期状态，必须按 accessible_customer_ids 做客户范围隔离。",
  "params_schema": {
    "billing_month": {
      "type": "string",
      "required": false
    },
    "status": {
      "type": "string",
      "required": false
    },
    "customer_id": {
      "type": "string",
      "required": false
    }
  },
  "examples": [
    "查询我能看的云账单和发票状态",
    "有哪些客户账单或发票有争议",
    "2026 年 6 月云商品账单状态"
  ],
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "cloud_bills"
  },
  "required_permissions": [
    "cloud:read"
  ],
  "filter_mapping": {
    "billing_month": {
      "field": "billing_month",
      "op": "eq"
    },
    "status": {
      "field": "status",
      "op": "eq"
    },
    "customer_id": {
      "field": "customer_id",
      "op": "eq"
    }
  }
}
