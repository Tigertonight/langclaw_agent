{
  "intent_code": "retail.query.sales",
  "handler_type": "intent_query",
  "version": "1",
  "description": "查询零售门店销量数据，包括各门店、各品类的销售额和销量",
  "params_schema": {
    "store": {
      "type": "string",
      "required": false,
      "examples": [
        "城西万达旗舰店",
        "滨江银泰标准店"
      ]
    },
    "product": {
      "type": "string",
      "required": false,
      "examples": [
        "经典拿铁",
        "抹茶星冰乐"
      ]
    },
    "category": {
      "type": "string",
      "required": false,
      "examples": [
        "咖啡",
        "甜点",
        "冰饮"
      ]
    },
    "time_range": {
      "type": "string",
      "required": false,
      "examples": [
        "今天",
        "本周",
        "本月"
      ]
    }
  },
  "examples": [
    "查一下城西万达旗舰店今天卖了多少",
    "各门店销量排行",
    "咖啡品类销售情况",
    "滨江银泰标准店销售额"
  ],
  "confidence_threshold": "medium",
  "sub_tools_available": false,
  "tool_binding": {
    "tool_name": "query_business_data",
    "resource": "retail_sales"
  },
  "required_permissions": [],
  "filter_mapping": {
    "store": {
      "field": "store_name",
      "op": "contains"
    },
    "product": {
      "field": "product",
      "op": "contains"
    },
    "category": {
      "field": "category",
      "op": "eq"
    }
  }
}
